[Unit]
Description=nereus daemon (input remapping, macros, profiles)
Documentation=https://github.com/mikegio27/nereus
After=systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
Type=simple
# Config lives system-wide here by default. Point this at a user's config with
# --config-dir /home/<user>/.config/nereus for a single-user desktop.
ExecStart=/usr/local/bin/nereus daemon --config-dir /etc/nereus
Restart=on-failure
RestartSec=2

# Needs read on /dev/input/event* and write on /dev/uinput.
SupplementaryGroups=input
DeviceAllow=/dev/uinput rw
DeviceAllow=char-input rw

# Hardening (relaxed where the daemon genuinely needs access).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
RuntimeDirectory=nereus
# The daemon persists active_profile back to its config dir (set_profile), so the
# config dir must be writable. Adjust if you move config elsewhere (a user's
# ~/.config needs ProtectHome relaxed and that path added here instead).
ReadWritePaths=/etc/nereus /run
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
